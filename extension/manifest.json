{
  "manifest_version": 3,
  "name": "X Routing",
  "version": "0.2.0",
  "description": "Open x.com and twitter.com posts in a login-free reader instead of X.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "https://api.fxtwitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://api.vxtwitter.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/content-feed-fanout.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/content-redirect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/reader.html",
        "src/shared/feed-scraper.js",
        "src/shared/rewriter.js",
        "src/storage.js"
      ],
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open this post without X"
  }
}
